DB_PASSWORD=changeme
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/myapp_dev"

# Anthropic API key used to parse salawat counts from messages (claude.js)
ANTHROPIC_API_KEY=
# Optional: model override, defaults to claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-haiku-4-5-20251001

# WhatsApp group ID to post updates to, e.g. "1234567890-1234567890@g.us"
GROUP_ID=

# Salawat count goal (default: 100000)
SALAWAT_GOAL=100000
# Delay in ms between sent messages (default: 1500)
SEND_DELAY_MS=1500

# Directory for local state: WhatsApp auth creds and count.json (default: ./data)
DATA_DIR=./data

# pino log level for the WhatsApp socket, e.g. silent, info, debug (default: silent)
LOG_LEVEL=silent
