DB_PASSWORD=changeme
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/myapp_dev"

# Anthropic API key used to parse salawat counts from messages (claude.js)
ANTHROPIC_API_KEY=
# Optional: model override, defaults to claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-haiku-4-5-20251001

# WhatsApp group ID to post updates to, e.g. "1234567890-1234567890@g.us"
GROUP_ID=

# Salawat count goal (default: 100000)
SALAWAT_GOAL=100000
# Max salawat accepted in a single submission (default: 10000). A submission
# above this is ignored entirely - no reply, nothing recorded.
MAX_SALAWAT_PER_SUBMISSION=10000
# Delay in ms between sent messages, e.g. group-join welcomes (default: 1500)
SEND_DELAY_MS=1500
# Delay in ms between individual weekly-digest DMs (default: 60000 = 1 minute).
# Kept much longer than SEND_DELAY_MS on purpose - a tight loop of DMs to many
# different people reads as spammy/bot-like to WhatsApp's abuse detection.
DIGEST_SEND_DELAY_MS=60000

# Directory for local state: WhatsApp auth creds and count.json (default: ./data)
DATA_DIR=./data

# pino log level for the WhatsApp socket, e.g. silent, info, debug (default: silent)
LOG_LEVEL=silent

# One-time escape hatch: set to "true" to wipe DATA_DIR/auth on the next
# startup (forces a fresh QR scan - use after a logout/invalid session).
# UNSET IT AGAIN after the fresh scan succeeds, or every future restart will
# wipe the new session too.
RESET_AUTH=false

# Internal-only HTTP endpoint for triggering the weekly salawat digest DM
# (POST /weekly-digest). Only reachable on Railway's private network / localhost -
# never expose this port publicly. The endpoint stays disabled unless this secret
# is set; the caller must send it as the "x-internal-secret" header.
INTERNAL_API_SECRET=
# Port the internal server listens on (default: 8080)
INTERNAL_PORT=8080
